  ai_model: AIModelConfig;
  ui_style: "modern-minimal" | "business" | "warm" | "tech";
  target_users: string;
  business_type: string;
}

/** 项目 */
export interface Project {
  id: string;
  user_id: string;
  name: string;
  description: string;
  config: ProjectConfig;
  status: ProjectStatus;
  created_at: string;
  updated_at: string;
}

/** 用户 */
